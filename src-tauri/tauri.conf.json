{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Punchcard",
  "version": "0.0.1",
  "identifier": "com.issacroy.punchcard",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Punchcard",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "timeline.html"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
