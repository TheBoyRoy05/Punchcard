{
  "name": "punchcard",
  "version": "0.0.1",
  "description": "Track time on Obsidian notes as blocks on a timeline.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run wasm",
    "dev": "vite",
    "dev:plugin": "npm run wasm && node esbuild.config.mjs",
    "build": "npm run wasm && tsc --noEmit && npm run svelte-check && vite build && node esbuild.config.mjs production",
    "lint": "eslint .",
    "pretest": "npm run wasm",
    "test": "vitest run --passWithNoTests && tsc --noEmit",
    "test:ui": "playwright test --project=ui",
    "screenshots": "playwright test --project=screenshots",
    "svelte-check": "svelte-check --tsconfig tsconfig.json",
    "tauri": "tauri",
    "wasm": "node scripts/build-wasm.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@lucide/svelte": "^1.70.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "^2",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "obsidian": "1.13.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.0",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
